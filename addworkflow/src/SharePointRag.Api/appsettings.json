{
  "Logging": {
    "LogLevel": {
      "Default":              "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents":     "Information",
      "SharePointRag":        "Debug"
    }
  },
  "AllowedHosts": "*",

  "AgentAuthentication": {
    "ClientId":     "<YOUR-BOT-APP-CLIENT-ID>",
    "ClientSecret": "<YOUR-BOT-APP-CLIENT-SECRET>",
    "TenantId":     "<YOUR-TENANT-ID>"
  },

  "GlobalGraph": {
    "TenantId":     "<YOUR-TENANT-ID>",
    "ClientId":     "<YOUR-GLOBAL-GRAPH-APP-CLIENT-ID>",
    "ClientSecret": "<YOUR-GLOBAL-GRAPH-APP-CLIENT-SECRET>"
  },

  "AzureOpenAI": {
    "Endpoint":            "https://<YOUR-AOAI-RESOURCE>.openai.azure.com/",
    "ApiKey":              "<YOUR-AOAI-KEY>",
    "ChatDeployment":      "gpt-4o",
    "EmbeddingDeployment": "text-embedding-3-large",
    "EmbeddingDimensions": 3072
  },

  // ── Vector store backend selection ───────────────────────────────────────────
  // Provider: "LiteGraph" (default, embedded SQLite, no server) or "Chroma" (external HTTP server)
  // Change Provider and restart — no code changes required.
  "VectorStore": {
    "Provider": "LiteGraph"
  },

  // ── LiteGraph: embedded SQLite persistent graph + vector store ───────────────
  // Active when VectorStore:Provider = "LiteGraph" (default).
  // One SQLite file, one Tenant, one Graph per RAG system — zero infrastructure.
  //
  // Storage layout:
  //   litegraph.db
  //     Tenant "RAGSystem"
  //       Graph "General"          ← one per system, fully isolated
  //       Graph "PastPerformance"
  //       Graph "Contracts"
  //       Graph "AllContent"
  //         Nodes (one per DocumentChunk)
  //           Tags:    SourceId, DataSourceName, ConnectorType, ChunkIndex, TotalChunks
  //           Data:    { Title, Url, Author, LastModified, Content, Metadata }
  //           Vectors: [{ Model, Dimensionality, Content, Vectors=[…] }]
  "LiteGraph": {
    "DatabasePath":   "/app/data/litegraph.db",
    "TenantName":     "RAGSystem",
    "EmbeddingModel": "text-embedding-3-large"
  },

  // ── ChromaDB: external HTTP vector database ────────────────────────────────
  // Active when VectorStore:Provider = "Chroma".
  // Requires a running Chroma server:
  //   docker run -p 8000:8000 chromadb/chroma
  //
  // Each RAG system maps to one Chroma collection: "{CollectionPrefix}{systemName}"
  //   e.g. "rag_General", "rag_PastPerformance", "rag_Contracts", "rag_AllContent"
  //
  // Collections are created automatically on first use.
  "Chroma": {
    "Endpoint":          "http://localhost:8000/api/v1/",
    "ApiKey":            "",
    "Tenant":            "",
    "Database":          "",
    "CollectionPrefix":  "rag_",
    "DistanceFunction":  "cosine",
    "DefaultTopK":       20,
    "TimeoutSeconds":    30
  },

  "Chunking": {
    "MaxTokensPerChunk": 512,
    "OverlapTokens":     64
  },


  "Agent": {
    "SystemPrompt": "You are an intelligent assistant that answers questions using content from the organisation's knowledge base.\n\nRules:\n- Only answer from the provided context chunks.\n- Always cite the source (title + URL or data source name) for every claim.\n- If the context does not contain enough information, say so clearly.\n- Be concise but complete.",
    "MaxTokens":    1024,
    "Temperature":  0.2
  },

  "SharePointRagAgent":   { "SystemNames": [ "General" ] },
  "PastPerformanceAgent": {
    "SystemNames": [ "PastPerformance", "Contracts" ],

    // External AI plugins — called as tools by GPT-4o during the PP pipeline.
    // Set Enabled=true and fill in your credentials to activate a plugin.
    // AlwaysInvokeForIntents: bypass GPT-4o routing and always call this plugin.
    "ExternalPlugins": [

      // Example 1: Azure OpenAI specialist (separate resource or partner instance)
      {
        "Name":         "contract_ai_specialist",
        "Description":  "Specialised GovCon AI for deep contract analysis and FAR compliance.",
        "EndpointType": "OpenAiCompatible",
        "Endpoint":     "https://<SPECIALIST-RESOURCE>.openai.azure.com/openai/deployments/gpt-4o",
        "ApiKey":       "<SPECIALIST-KEY>",
        "Model":        "gpt-4o",
        "SystemPrompt": "You are a GovCon contracting expert. Focus on FAR/DFARS compliance.",
        "MaxTokens":    1000,
        "TimeoutSeconds": 30,
        "Enabled":      false,
        "AlwaysInvokeForIntents": []
      },

      // Example 2: Custom HTTP endpoint (SAM.gov, Deltek AI, proprietary system)
      {
        "Name":         "sam_gov_ai",
        "Description":  "Queries SAM.gov federal procurement data and vendor past performance.",
        "EndpointType": "CustomHttp",
        "Endpoint":     "https://api.sam.gov/ai/v1/query",
        "ApiKey":       "<SAM_GOV_API_KEY>",
        "RequestTemplate": "{"query": "{question}", "context": "{context}"}",
        "ResponsePath":    "result.answer",
        "MaxTokens":    1000,
        "TimeoutSeconds": 30,
        "Enabled":      false,
        "AlwaysInvokeForIntents": ["IdentifyGaps"]
      },

      // Example 3: Microsoft Copilot / Azure AI Agent
      {
        "Name":         "copilot_analyst",
        "Description":  "Copilot agent for proposal compliance review and narrative critique.",
        "EndpointType": "MicrosoftCopilot",
        "Endpoint":     "https://api.agentservice.microsoft.com",
        "ApiKey":       "<BEARER_TOKEN>",
        "AgentId":      "<COPILOT_AGENT_ID>",
        "SystemPrompt": "Focus on GovCon past performance narrative quality.",
        "MaxTokens":    1000,
        "TimeoutSeconds": 60,
        "Enabled":      false,
        "AlwaysInvokeForIntents": ["GenerateVolumeSection"]
      }
    ]
  },

  "RagRegistry": {

    "DataSources": [

      {
        "Name": "GeneralDocs", "Type": "SharePoint",
        "CrawlParallelism": 4, "DeltaSupported": true,
        "Properties": {
          "SiteUrl":           "https://contoso.sharepoint.com/sites/Corporate",
          "LibraryName":       "Documents",
          "AllowedExtensions": ".pdf,.docx,.pptx,.xlsx,.txt,.md,.html",
          "MaxFileSizeMb":     "50"
        }
      },

      {
        "Name": "PastPerformanceDocs", "Type": "SharePoint",
        "CrawlParallelism": 8, "DeltaSupported": true,
        "Properties": {
          "SiteUrl":           "https://contoso.sharepoint.com/sites/CaptureTeam",
          "LibraryName":       "PastPerformance",
          "ClientId":          "<PP-APP-CLIENT-ID>",
          "ClientSecret":      "<PP-APP-CLIENT-SECRET>",
          "AllowedExtensions": ".pdf,.docx,.xlsx",
          "MaxFileSizeMb":     "100"
        }
      },

      {
        "Name": "DeltekCostpointDB", "Type": "SqlDatabase",
        "CrawlParallelism": 4, "DeltaSupported": true,
        "Properties": {
          "ConnectionString":  "Server=costpoint.contoso.com;Database=CPAS;Integrated Security=true;TrustServerCertificate=true",
          "Provider":          "SqlServer",
          "Query":             "SELECT PROJ_ID AS Id, PROJ_ID + ' ' + PROJ_NAME + '. ' + ISNULL(PROJ_DESC,'') AS Content, PROJ_NAME AS Title, NULL AS Url, LAST_MOD_DATE AS ModifiedAt, CLIENT_ID AS ClientName, NAICS_CODE AS NAICSCode, CONTRACT_TYPE AS ContractType, CONTRACT_AMT AS ContractAmount, START_DATE AS StartDate, END_DATE AS EndDate, PROJ_STATUS AS ProjectStatus, CO_NAME AS ContractingOfficer, CO_EMAIL AS COEmail FROM GV_PROJECTS WHERE PROJ_STATUS IN ('A','C')",
          "IdColumn": "Id", "ContentColumn": "Content", "TitleColumn": "Title",
          "UrlColumn": "Url", "ModifiedAtColumn": "ModifiedAt"
        }
      },

      {
        "Name": "DeltekVantagepoint", "Type": "Deltek",
        "CrawlParallelism": 4, "DeltaSupported": true,
        "Properties": {
          "BaseUrl":  "https://yourfirm.deltekfirst.com/VantagePoint/api/v1",
          "ApiKey":   "Bearer <YOUR-DELTEK-TOKEN>",
          "Entities": "Projects,Clients",
          "Filter":   "ProjectStatus eq 'Active' or ProjectStatus eq 'Completed'",
          "PageSize": "200"
        }
      },

      {
        "Name": "ContractMatrices", "Type": "Excel",
        "CrawlParallelism": 2, "DeltaSupported": true,
        "Properties": {
          "FilePaths":     "/mnt/shared/contracts/award-matrices/*.xlsx",
          "SheetName":     "Contracts",
          "ContentColumn": "Description",
          "TitleColumn":   "ContractNumber"
        }
      },

      // ── Excel with explicit MetadataSchema ───────────────────────────────────
      // MetadataSchema documents the column structure so consumers (PP agent,
      // ContractExtractor, API clients) know what fields to expect in Metadata.
      {
        "Name": "CPARSExport", "Type": "Excel",
        "CrawlParallelism": 1, "DeltaSupported": false,
        "ReadOnly": false,
        "Properties": {
          "FilePaths":     "/mnt/shared/cpars/cpars-export.xlsx",
          "ContentColumn": "NarrativeText",
          "TitleColumn":   "ContractNumber"
        },
        "MetadataSchema": {
          "ContractNumber":      { "Type": "string",  "Description": "FAR contract number", "Required": true, "Examples": ["W912DQ-21-C-0042"] },
          "AgencyName":          { "Type": "string",  "Description": "Full awarding agency name", "Required": true },
          "CPARSRatingOverall":  { "Type": "string",  "Description": "Overall CPARS rating", "AllowedValues": ["Exceptional","Very Good","Satisfactory","Marginal","Unsatisfactory"] },
          "CPARSRatingQuality":  { "Type": "string",  "Description": "Quality of product or service rating", "AllowedValues": ["Exceptional","Very Good","Satisfactory","Marginal","Unsatisfactory"] },
          "CPARSRatingSchedule": { "Type": "string",  "Description": "Schedule/delivery rating", "AllowedValues": ["Exceptional","Very Good","Satisfactory","Marginal","Unsatisfactory"] },
          "ContractValue":       { "Type": "decimal", "Description": "Total obligated value in USD" },
          "StartDate":           { "Type": "date",    "Description": "Period of performance start" },
          "EndDate":             { "Type": "date",    "Description": "Period of performance end" }
        }
      },

      // ── Example: ReadOnly source — indexed by a separate ingestion service ────
      // This instance can SEARCH this store but will never write to it.
      // The MetadataSchema tells the PP agent what fields are available even
      // though there is no connector to introspect at runtime.
      {
        "Name": "ExternalCPARSDatabase",
        "Type": "SqlDatabase",
        "ReadOnly": true,
        "CrawlParallelism": 1,
        "DeltaSupported": false,
        "Properties": {},
        "MetadataSchema": {
          "ContractNumber":      { "Type": "string",  "Description": "Prime contract number", "Required": true },
          "AgencyName":          { "Type": "string",  "Description": "Awarding agency" },
          "AgencyAcronym":       { "Type": "string",  "Description": "e.g. DoD, HHS, DHS" },
          "ContractType":        { "Type": "string",  "Description": "Contract type: FFP, CPFF, T&M, IDIQ" },
          "ContractValue":       { "Type": "decimal", "Description": "Total obligated amount USD" },
          "StartDate":           { "Type": "date",    "Description": "PoP start date (YYYY-MM-DD)" },
          "EndDate":             { "Type": "date",    "Description": "PoP end date (YYYY-MM-DD)" },
          "ProjectStatus":       { "Type": "string",  "Description": "Active or Completed", "AllowedValues": ["Active","Completed"] },
          "NAICSCode":           { "Type": "string",  "Description": "6-digit NAICS code", "Examples": ["541512","541611"] },
          "CPARSRatingOverall":  { "Type": "string",  "Description": "Overall CPARS adjectival rating", "AllowedValues": ["Exceptional","Very Good","Satisfactory","Marginal","Unsatisfactory"] },
          "ContractingOfficer":  { "Type": "string",  "Description": "CO name" },
          "COEmail":             { "Type": "string",  "Description": "CO email address", "Searchable": false },
          "ConnectorType":       { "Type": "string",  "Description": "Internal field: source connector type", "Searchable": false }
        }
      }

    ],

    "Systems": [

      {
        "Name":            "General",
        "Description":     "General corporate knowledge base",
        "DataSourceNames": [ "GeneralDocs" ],
        "TopK":            5,
        "MinScore":        0.5
      },

      {
        "Name":            "PastPerformance",
        "Description":     "CPARS reports, PPQs, and past performance questionnaires (SharePoint)",
        "DataSourceNames": [ "PastPerformanceDocs" ],
        "TopK":            8,
        "MinScore":        0.45
      },

      {
        "Name":            "Contracts",
        "Description":     "Active contracts from Costpoint DB, Deltek Vantagepoint, Excel matrices, and CPARS export",
        "DataSourceNames": [ "DeltekCostpointDB", "DeltekVantagepoint", "ContractMatrices", "CPARSExport" ],
        "TopK":            10,
        "MinScore":        0.4
      },

      {
        "Name":            "AllContent",
        "Description":     "Federated search across all configured data sources",
        "DataSourceNames": [ "GeneralDocs", "PastPerformanceDocs", "DeltekCostpointDB", "DeltekVantagepoint", "ContractMatrices", "CPARSExport" ],
        "TopK":            12,
        "MinScore":        0.35
      }

    ]
  }
}
