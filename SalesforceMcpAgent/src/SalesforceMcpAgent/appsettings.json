{
  "Salesforce": {
    // Your Salesforce org login URL (not the experience/community URL).
    // Example: https://MyDomain.my.salesforce.com
    "InstanceUrl": "https://YOUR_ORG.my.salesforce.com",

    // MCP Server URL – copy from Salesforce Setup → MCP Servers → <server name> → Server URL
    // It typically ends in /sse  e.g.  .../api/mcp/sobject-all/sse
    "McpServerUrl": "https://YOUR_ORG.my.salesforce.com/api/mcp/sobject-all/sse",

    // External Client App (ECA) consumer key – from Salesforce Setup → External Client App Manager
    "ClientId": "YOUR_ECA_CONSUMER_KEY",

    // Consumer Secret (required for the Client-Credentials flow used in headless/server scenarios)
    "ClientSecret": "YOUR_ECA_CONSUMER_SECRET",

    // Optional: paste a pre-obtained access token here for quick testing.
    // When set, ClientId / ClientSecret are ignored.
    "StaticAccessToken": ""
  },

  "AzureOpenAI": {
    // Azure OpenAI resource endpoint
    "Endpoint": "https://YOUR_RESOURCE.openai.azure.com/",

    // Model deployment name in your Azure OpenAI resource
    "DeploymentName": "gpt-4o",

    // API key – leave blank to use DefaultAzureCredential (Managed Identity / Azure CLI)
    "ApiKey": "YOUR_AZURE_OPENAI_KEY"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "SalesforceMcpAgent": "Information"
    }
  }
}
