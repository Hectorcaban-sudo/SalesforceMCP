@page "/contracts/{Id:int}/review"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IContractRepository Repository
@inject IJSRuntime JS
@using System.Text.Json

<h1>Review Scanned Contract</h1>

@if (_contract is null)
{
    <p>Loading...</p>
}
else
{
    <div class="toolbar">
        <span class="badge badge-@_contract.Status.ToString().ToLowerInvariant()">@_contract.Status</span>
        <span>Source: <strong>@_contract.SourcePdfFileName</strong> (@_contract.PageCount pages)</span>
        <button class="btn btn-primary" @onclick="ApproveAndSave">Approve &amp; Save</button>
        <a class="btn btn-secondary" href="contracts/@_contract.Id/edit">Open full data-entry form</a>
        <a class="btn btn-secondary" href="/">Back to list</a>
    </div>

    <div class="review-shell">
        <div class="review-pdf-pane">
            <div class="pdf-toolbar">
                <button @onclick="PrevPage" disabled="@(_currentPage <= 1)">‹</button>
                <span class="pdf-page-indicator">Page @_currentPage of @_pageCount</span>
                <button @onclick="NextPage" disabled="@(_currentPage >= _pageCount)">›</button>
                <button @onclick="() => Zoom(-0.15)">−</button>
                <button @onclick="() => Zoom(0.15)">+</button>
                <span class="legend">
                    <span><span class="legend-swatch" style="background:var(--high-border)"></span>High confidence</span>
                    <span><span class="legend-swatch" style="background:var(--medium-border)"></span>Medium</span>
                    <span><span class="legend-swatch" style="background:var(--low-border)"></span>Low - please verify</span>
                </span>
            </div>
            <div class="pdf-scroll-area">
                <div class="pdf-canvas-wrapper">
                    <div id="pdfCanvasContainer"></div>
                    <div id="pdfOverlayLayer" class="pdf-overlay"></div>
                </div>
            </div>
        </div>

        <div class="review-fields-pane">
            @foreach (var group in FieldGroups)
            {
                <div class="field-section">
                    <h3>@group.Title</h3>
                    @foreach (var fieldName in group.FieldNames)
                    {
                        var extraction = FieldFor(fieldName);
                        <div id="field-row-@fieldName"
                             class="field-row @HighlightClass(extraction) @(_selectedFieldName == fieldName ? "selected-in-pdf" : "")"
                             @onclick="() => SelectField(fieldName)">
                            <label>@LabelFor(fieldName, extraction)</label>
                            <input type="text" value="@GetValue(fieldName)"
                                   @onclick:stopPropagation="true"
                                   @onchange="e => SetValue(fieldName, e.Value?.ToString())" />
                            <div style="display:flex; align-items:center; gap:.35rem;">
                                @if (extraction is not null)
                                {
                                    <span class="confidence-chip @extraction.Level.ToString().ToLowerInvariant()">@((extraction.Confidence * 100).ToString("0"))%</span>
                                    @if (extraction.SourcePageNumber is not null)
                                    {
                                        <button class="page-jump-btn" @onclick:stopPropagation="true" @onclick="() => SelectField(fieldName)">
                                            @(extraction.HasBoundingBox ? "show on PDF" : $"p.{extraction.SourcePageNumber}")
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="field-section">
                <h3>Schedule of Supplies/Services (Blocks 19-24)</h3>
                <table class="line-items-table">
                    <thead>
                        <tr><th>Item #</th><th>Description</th><th>Qty</th><th>Unit</th><th>Unit Price</th><th>Amount</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var li in _contract.LineItems)
                        {
                            <tr>
                                <td>@li.ItemNumber</td>
                                <td>@li.Description</td>
                                <td>@li.Quantity</td>
                                <td>@li.Unit</td>
                                <td>@li.UnitPrice?.ToString("C")</td>
                                <td>@li.Amount?.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="field-section">
                <h3>Clauses &amp; Provisions (@_contract.Clauses.Count found)</h3>
                <table class="clauses-table">
                    <thead>
                        <tr><th>Number</th><th>Title</th><th>Category</th><th>Type</th><th>Section</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cl in _contract.Clauses.OrderBy(c => c.Section).ThenBy(c => c.ClauseNumber))
                        {
                            <tr>
                                <td>@cl.ClauseNumber</td>
                                <td>@cl.Title</td>
                                <td>@cl.Category</td>
                                <td>@cl.IncorporationType</td>
                                <td>@cl.Section</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Sf1449Contract? _contract;
    private int _currentPage = 1;
    private int _pageCount = 1;
    private string? _selectedFieldName;

    private IJSObjectReference? _module;
    private DotNetObjectReference<ContractReview>? _dotNetRef;
    private string? _highlightsJson;

    private record FieldGroup(string Title, string[] FieldNames);

    private static readonly FieldGroup[] FieldGroups =
    {
        new("Identification (Blocks 1-8)", new[]
        {
            nameof(Sf1449Contract.RequisitionNumber), nameof(Sf1449Contract.ContractNumber),
            nameof(Sf1449Contract.AwardEffectiveDate), nameof(Sf1449Contract.OrderNumber),
            nameof(Sf1449Contract.SolicitationNumber), nameof(Sf1449Contract.SolicitationIssueDate),
            nameof(Sf1449Contract.SolicitationContactName), nameof(Sf1449Contract.SolicitationContactPhone),
            nameof(Sf1449Contract.OfferDueDateLocalTime)
        }),
        new("Issued By (Block 9)", new[]
        {
            nameof(Sf1449Contract.IssuedByCode), nameof(Sf1449Contract.IssuedByName),
            nameof(Sf1449Contract.IssuedByAddress)
        }),
        new("Set-Aside / NAICS (Block 10)", new[]
        {
            nameof(Sf1449Contract.NaicsCode), nameof(Sf1449Contract.SizeStandardUsd),
            nameof(Sf1449Contract.SetAsidePercent)
        }),
        new("Contractor / Payment (Blocks 17-18)", new[]
        {
            nameof(Sf1449Contract.ContractorCode), nameof(Sf1449Contract.ContractorName),
            nameof(Sf1449Contract.ContractorAddress), nameof(Sf1449Contract.ContractorPhone),
            nameof(Sf1449Contract.PaymentWillBeMadeByCode)
        }),
        new("Award (Blocks 25-31)", new[]
        {
            nameof(Sf1449Contract.AccountingAndAppropriationData), nameof(Sf1449Contract.TotalAwardAmount),
            nameof(Sf1449Contract.ContractingOfficerName), nameof(Sf1449Contract.ContractingOfficerSignedDate)
        }),
    };

    protected override async Task OnInitializedAsync()
    {
        _contract = await Repository.GetByIdAsync(Id);
        if (_contract is not null)
        {
            _highlightsJson = BuildHighlightsJson(_contract);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _contract?.SourcePdfStoragePath is { } path)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pdfHighlightViewer.js");
            _dotNetRef = DotNetObjectReference.Create(this);

            _pageCount = await _module.InvokeAsync<int>("init", "pdfCanvasContainer", "pdfOverlayLayer", path, _dotNetRef);
            if (_pageCount <= 0) _pageCount = _contract.PageCount is > 0 ? _contract.PageCount : 1;

            await RenderCurrentPage();
        }
    }

    private async Task RenderCurrentPage()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("renderPage", "pdfCanvasContainer", _currentPage, _highlightsJson);
    }

    /// <summary>Builds the JSON array the JS overlay renderer consumes: one entry per field that resolved to a page location.</summary>
    private string BuildHighlightsJson(Sf1449Contract contract)
    {
        var items = contract.FieldExtractions
            .Where(f => f.HasBoundingBox && f.SourcePageNumber is not null)
            .Select(f => new
            {
                fieldName = f.FieldName,
                page = f.SourcePageNumber!.Value,
                leftPct = f.BoxLeftPct,
                topPct = f.BoxTopPct,
                widthPct = f.BoxWidthPct,
                heightPct = f.BoxHeightPct,
                level = f.Level.ToString().ToLowerInvariant(),
                confidence = f.Confidence,
                label = f.DisplayLabel ?? f.FieldName
            });

        return JsonSerializer.Serialize(items);
    }

    private FieldExtraction? FieldFor(string fieldName) =>
        _contract?.FieldExtractions.FirstOrDefault(f => f.FieldName == fieldName);

    private string LabelFor(string fieldName, FieldExtraction? extraction) =>
        extraction?.DisplayLabel ?? fieldName;

    private string HighlightClass(FieldExtraction? extraction) => extraction is null
        ? ""
        : "field-highlight-" + extraction.Level.ToString().ToLowerInvariant();

    private string GetValue(string fieldName)
    {
        var prop = typeof(Sf1449Contract).GetProperty(fieldName);
        var value = prop?.GetValue(_contract);
        return value?.ToString() ?? string.Empty;
    }

    private void SetValue(string fieldName, string? value)
    {
        if (_contract is null) return;
        var prop = typeof(Sf1449Contract).GetProperty(fieldName);
        if (prop is null || !prop.CanWrite) return;

        try
        {
            var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            object? converted = string.IsNullOrWhiteSpace(value)
                ? null
                : Convert.ChangeType(value, targetType);
            prop.SetValue(_contract, converted);

            var extraction = FieldFor(fieldName);
            if (extraction is not null) extraction.ReviewedByUser = true;
        }
        catch
        {
            // Ignore un-parseable manual edits here; the full data-entry form has
            // proper typed inputs (date pickers, checkboxes, dropdowns) for
            // fields that need stricter validation.
        }
    }

    /// <summary>Clicking a field in the side list: jump the PDF to its page (if needed) and flash its box.</summary>
    private async Task SelectField(string fieldName)
    {
        _selectedFieldName = fieldName;
        var extraction = FieldFor(fieldName);

        if (extraction?.SourcePageNumber is { } page && page != _currentPage)
        {
            _currentPage = page;
            await RenderCurrentPage();
        }

        if (_module is not null && extraction is { HasBoundingBox: true })
        {
            await _module.InvokeVoidAsync("flashField", "pdfCanvasContainer", fieldName);
        }
    }

    /// <summary>Called from JS when a highlight box on the PDF itself is clicked - scrolls/selects the matching side-panel row.</summary>
    [JSInvokable]
    public async Task OnHighlightClicked(string fieldName)
    {
        _selectedFieldName = fieldName;
        StateHasChanged();
        await JS.InvokeVoidAsync("eval",
            $"document.getElementById('field-row-{fieldName}')?.scrollIntoView({{behavior:'smooth', block:'center'}});");
    }

    private async Task PrevPage()
    {
        if (_currentPage <= 1) return;
        _currentPage--;
        await RenderCurrentPage();
    }

    private async Task NextPage()
    {
        if (_currentPage >= _pageCount) return;
        _currentPage++;
        await RenderCurrentPage();
    }

    private async Task Zoom(double delta)
    {
        if (_module is null) return;
        await _module.InvokeAsync<double>("setZoom", "pdfCanvasContainer", delta);
        await RenderCurrentPage();
    }

    private async Task ApproveAndSave()
    {
        if (_contract is null) return;
        _contract.Status = ContractStatus.Reviewed;
        await Repository.UpdateAsync(_contract);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose", "pdfCanvasContainer");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (page navigation/tab close) - nothing to clean up client-side.
        }

        _dotNetRef?.Dispose();
    }
}
