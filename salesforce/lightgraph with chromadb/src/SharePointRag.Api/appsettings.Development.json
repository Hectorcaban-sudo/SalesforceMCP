{
  "Logging": {
    "LogLevel": {
      "Default":       "Debug",
      "SharePointRag": "Debug"
    }
  },
  "VectorStore": { "Provider": "LiteGraph" },
  "LiteGraph": {
    "DatabasePath": "./dev-data/litegraph.db"
  },
  "Chroma": {
    "Endpoint": "http://localhost:8000/api/v1/",
    "CollectionPrefix": "dev_rag_"
  },
  "Agent": { "Temperature": 0.0 },
  "Batching": { "EmbeddingBatchSize": 32, "UpsertBatchSize": 20, "FlushTimeoutMs": 500 },
  "RagRegistry": {
    "Systems": [
      { "Name": "General",        "MinScore": 0.2 },
      { "Name": "PastPerformance","MinScore": 0.2 },
      { "Name": "Contracts",      "MinScore": 0.2 },
      { "Name": "AllContent",     "MinScore": 0.2 }
    ]
  }
}
